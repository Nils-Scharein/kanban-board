# syntax=docker/dockerfile:1
ARG TARGETARCH


FROM jenkins/ssh-agent:jdk21 AS base-amd64
ADD https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-x86_64.tar.gz /tmp/gcloud.tar.gz


FROM jenkins/ssh-agent:jdk21 AS base-arm64
ADD https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-arm.tar.gz /tmp/gcloud.tar.gz


FROM base-${TARGETARCH} AS final

ARG TARGETARCH
ARG DOCKER_GID=984

ENV CLOUDSDK_PYTHON=/usr/bin/python3
ENV PATH="/opt/google-cloud-sdk/bin:${PATH}"


RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*


RUN <<'INSTALL_DOCKER'
set -e

apt-get update
apt-get install -y ca-certificates curl

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/debian/gpg -o /etc/apt/keyrings/docker.asc
chmod a+r /etc/apt/keyrings/docker.asc

tee /etc/apt/sources.list.d/docker.sources <<SOURCES
Types: deb
URIs: https://download.docker.com/linux/debian
Suites: $(. /etc/os-release && echo "$VERSION_CODENAME")
Components: stable
Architectures: $(dpkg --print-architecture)
Signed-By: /etc/apt/keyrings/docker.asc
SOURCES

apt-get update
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

rm -rf /var/lib/apt/lists/*
INSTALL_DOCKER


RUN <<'JOIN_DOCKER_GROUP'
set -e

getent group "${DOCKER_GID}" >/dev/null || groupadd -g "${DOCKER_GID}" dockerhost
usermod -aG "$(getent group "${DOCKER_GID}" | cut -d: -f1)" jenkins
JOIN_DOCKER_GROUP


RUN <<'INSTALL_GCLOUD'
set -e

tar -xzf /tmp/gcloud.tar.gz -C /opt
/opt/google-cloud-sdk/install.sh --quiet --path-update=false
ln -s /opt/google-cloud-sdk/bin/gcloud /usr/local/bin/gcloud
ln -s /opt/google-cloud-sdk/bin/docker-credential-gcloud /usr/local/bin/docker-credential-gcloud
rm /tmp/gcloud.tar.gz
INSTALL_GCLOUD
